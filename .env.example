# CrisisAware Production & Local Configuration

# Secret Key for Flask Session Security (Generate a random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Enable or disable debug mode (False for production)
FLASK_DEBUG=False

# Configurable alert radius in kilometers (default: 50 km)
ALERT_RADIUS_KM=50

# Database file path (default: floodguard.db)
DATABASE=floodguard.db
# Optional external SQLite path override, e.g. sqlite:////path/to/db.sqlite3
# DATABASE_URL=

# Seed demo NGOs/alerts into the database (default: true). Auto-disabled on Vercel.
SEED_DEMO_DATA=true

# Optional Gemini API Key for AI Assistant (leave empty if unused)
GEMINI_API_KEY=your_gemini_api_key_here

# Exactly one platform administrator (created on startup if missing)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Gmail SMTP Configuration (Use a Gmail App Password, not regular password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com
# Aliases also supported: SMTP_SERVER, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM, MAIL_FROM
